{
  "name": "pi-things",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extensions: unified web tools",
  "license": "MIT",
  "keywords": ["pi-package"],
  "bin": {
    "pi-snapshot": "./extensions/pi-safety/pi-snapshot.ts"
  },
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test:pi-safety": "bun --no-env-file test extensions/pi-safety/*.test.ts",
    "test:shell-leash": "bun test extensions/shell-leash/*.test.ts",
    "test:split-handoff": "bun test extensions/split-handoff.test.ts",
    "typecheck:web-tools": "bunx tsc -p extensions/web-tools/tsconfig.json",
    "typecheck:pi-safety": "bunx tsc -p extensions/pi-safety/tsconfig.json",
    "typecheck:shell-leash": "bunx tsc -p extensions/shell-leash/tsconfig.json",
    "typecheck:subagents": "bunx tsc -p extensions/subagents/tsconfig.json",
    "typecheck:single-extensions": "bunx tsc -p extensions/tsconfig.json",
    "typecheck": "bun run typecheck:web-tools && bun run typecheck:pi-safety && bun run typecheck:shell-leash && bun run typecheck:subagents && bun run typecheck:single-extensions"
  },
  "pi": {
    "extensions": [
      "./extensions/web-tools/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/split-fork.ts",
      "./extensions/split-handoff.ts",
      "./extensions/goal.ts",
      "./extensions/comment.ts",
      "./extensions/clarify.ts",
      "./extensions/shell-leash/index.ts",
      "./extensions/pi-safety/index.ts"
    ],
    "skills": ["./skills", "./extensions/web-tools/skills"]
  },
  "dependencies": {
    "defuddle": "^0.15.0",
    "diff": "8.0.4",
    "glob-to-regexp": "0.4.1",
    "ignore": "^7.0.5",
    "just-bash": "^2.14.2",
    "linkedom": "^0.18.12",
    "minimatch": "10.2.5",
    "yaml": "^2.8.1",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@earendil-works/pi-agent-core": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@types/bun": "1.3.13",
    "@types/glob-to-regexp": "0.4.4",
    "@types/node": "^24.4.0",
    "typebox": "1.3.7",
    "typescript": "^6.0.0-dev.20260416"
  }
}
