{
  "name": "pi-things",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extensions: unified web tools",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "bun run lint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check",
    "check:write": "bun run lint:fix && bun run format && bun run check",
    "sync:pstack": "bun tools/sync-pstack.ts",
    "test:split-handoff": "bun test extensions/split-handoff.test.ts",
    "test:poteto": "bun --no-env-file test extensions/poteto/*.test.ts",
    "test:session-messages": "bun --no-env-file test extensions/session-messages/*.test.ts",
    "test:subagents": "bun --no-env-file test extensions/subagents/*.test.ts",
    "test:model-router": "bun --no-env-file test extensions/model-router/*.test.ts",
    "smoke:model-router": "bun --no-env-file run extensions/model-router/smoke.ts",
    "eval:model-router": "bun --no-env-file run extensions/model-router/evaluate.ts",
    "typecheck:model-router": "bunx tsc -p extensions/model-router/tsconfig.json",
    "typecheck:web-tools": "bunx tsc -p extensions/web-tools/tsconfig.json",
    "typecheck:subagents": "bunx tsc -p extensions/subagents/tsconfig.json",
    "typecheck:session-messages": "bunx tsc -p extensions/session-messages/tsconfig.json",
    "typecheck:poteto": "bunx tsc -p extensions/poteto/tsconfig.json",
    "typecheck:single-extensions": "bunx tsc -p extensions/tsconfig.json",
    "typecheck": "bun run typecheck:web-tools && bun run typecheck:subagents && bun run typecheck:single-extensions && bun run typecheck:poteto && bun run typecheck:model-router && bun run typecheck:session-messages",
    "test:mdreview": "bun test extensions/mdreview.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/web-tools/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/session-messages/index.ts",
      "./extensions/split-fork.ts",
      "./extensions/split-handoff.ts",
      "./extensions/goal.ts",
      "./extensions/poteto/index.ts",
      "./extensions/comment.ts",
      "./extensions/mdreview.ts",
      "./extensions/clarify.ts",
      "./extensions/model-router/index.ts"
    ],
    "skills": [
      "./skills",
      "./extensions/web-tools/skills"
    ]
  },
  "dependencies": {
    "defuddle": "^0.15.0",
    "ignore": "^7.0.5",
    "linkedom": "^0.18.12",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "1.3.13",
    "@types/node": "^24.4.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typebox": "1.3.7",
    "typescript": "^6.0.0-dev.20260416"
  }
}
